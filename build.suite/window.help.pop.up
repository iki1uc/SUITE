window.SUITE_POP = {

    active: false,
    message: "",
    response: "",

    open(msg, resp) {
        this.active = true;
        this.message = msg;
        this.response = resp;
    },

    close() {
        this.active = false;
    },

    render() {
        if (!this.active) return;

        const box = document.getElementById("popup");
        box.innerText = `${this.response}: ${this.message}`;
        box.style.display = "block";
    }
};
